---
import BaseLayout from "../layouts/BaseLayout.astro";
import { REGIONS, SERVICES } from "../data/locations.js";
import { CITY_CONTEXT } from "../data/cityContext.js";

interface Props {
  city: { slug: string; name: string; region: string; tier: number };
  region: { name: string; slug: string };
  service: { slug: string; name: string; shortName: string };
  otherService: { slug: string; name: string };
  content: any;
  nearby: { slug: string; name: string }[];
}

const { city, region, service, otherService, content, nearby } = Astro.props;
const cityContext = CITY_CONTEXT[city.slug];

// The generic 3 service FAQs plus one genuinely city-specific question --
// see cityContext.js for why each city's is different, not templated.
const allFaqs = cityContext ? [...content.faqs, cityContext.localFaq] : content.faqs;

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: allFaqs.map((f: any) => ({
    "@type": "Question",
    name: typeof f.q === "function" ? f.q(city) : f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title={`${service.name} in ${city.name}, AZ | Arizona Pigeon Proofing`}
  description={`${service.name} for homeowners in ${city.name}, Arizona. Free quotes, local crews, 24–48 hour turnaround.`}
  pageData={{ content_group: "city_service_page", metro: city.region, service: service.slug, city: city.slug }}
>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">{region.name} &middot; {city.name}, AZ</span>
      <h1>{service.name} in {city.name}</h1>
      <p class="lede">{content.intro(city)}</p>
      <div class="cta-row">
        <a href="/quote/" class="btn amber" data-gtm-event="cta_click" data-gtm-params={`{"cta_location":"city_page_hero","metro":"${city.region}","service":"${service.slug}"}`}>Get a Free Quote</a>
        <a href="tel:+15205550148" class="btn outline">Call (520) 555-0148</a>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap narrow">
      <h2>Why this matters in {city.name}</h2>
      <p>{content.problemFraming(city, region)}</p>
      {cityContext && (
        <>
          <p>{cityContext.character}</p>
          {cityContext.communities.length > 0 && (
            <p class="communities-note">
              <strong>Communities we serve in {city.name}:</strong> {cityContext.communities.join(", ")}
            </p>
          )}
          <p class="jurisdiction-note">
            {cityContext.jurisdiction.type === "incorporated"
              ? `${city.name} is incorporated, so permits and inspections go through ${cityContext.jurisdiction.authority} rather than the county.`
              : `${city.name} is unincorporated, so permits and inspections go through ${cityContext.jurisdiction.authority} rather than a local town government.`}
          </p>
        </>
      )}
    </div>
  </section>

  <section class="alt">
    <div class="wrap narrow">
      <h2>How it works</h2>
      <div class="process-list">
        {content.process.map((step: any, i: number) => (
          <div class="process-step">
            <div class="n">{String(i + 1).padStart(2, "0")}</div>
            <div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap narrow">
      <h2>Frequently asked — {city.name}</h2>
      <div class="faq-list">
        {allFaqs.map((f: any) => (
          <details class="faq-item">
            <summary>{typeof f.q === "function" ? f.q(city) : f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap narrow">
      <div class="cross-links">
        <div>
          <h3>Also serving nearby</h3>
          <div class="pill-row">
            {nearby.map((n) => (
              <a class="pill" href={`/${service.slug}/${n.slug}/`}>{n.name}</a>
            ))}
          </div>
        </div>
        <div>
          <h3>Other service in {city.name}</h3>
          <a class="pill teal" href={`/${otherService.slug}/${city.slug}/`}>{otherService.name}</a>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2>Ready for a free {city.name} quote?</h2>
          <p>Tell us your city and what you're seeing — a local crew gets back to you within 24–48 hours.</p>
        </div>
        <a href="/quote/" class="btn amber" data-gtm-event="cta_click" data-gtm-params={`{"cta_location":"city_page_footer_cta","metro":"${city.region}","service":"${service.slug}"}`}>Get a Free Quote</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</BaseLayout>

<style>
  .page-hero { background: linear-gradient(160deg, #0d1620 0%, #132430 55%, #173247 100%); color: #f2f5f1; }
  .page-hero .wrap { padding: 3.5rem 1.5rem 4rem; }
  .page-hero .eyebrow { color: #7fd1d6; }
  .page-hero h1 { font-size: 2.3rem; line-height: 1.1; margin: 0.6rem 0 0.9rem; color: #fbfbf7; max-width: 22ch; }
  .page-hero .lede { font-size: 1.05rem; color: #c9d4d0; max-width: 52ch; margin: 0 0 1.6rem; }
  .page-hero .cta-row { display: flex; gap: 0.8rem; flex-wrap: wrap; }
  .page-hero .btn.outline { border-color: rgba(255, 255, 255, 0.28); color: #f2f5f1; }
  .page-hero .btn.outline:hover { background: rgba(255, 255, 255, 0.08); }

  .wrap.narrow { max-width: 760px; }
  section.alt { background: var(--surface-2); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }

  .communities-note { font-size: 0.92rem; }
  .communities-note strong { font-weight: 700; }
  .jurisdiction-note { font-size: 0.85rem; color: var(--text-dim); font-style: italic; }

  .process-list { display: flex; flex-direction: column; gap: 1.4rem; margin-top: 1.5rem; }
  .process-step { display: grid; grid-template-columns: 44px 1fr; gap: 1rem; }
  .process-step .n { font-family: ui-monospace, monospace; font-weight: 700; color: var(--teal); }
  .process-step h3 { font-size: 1.05rem; margin-bottom: 0.3rem; }
  .process-step p { margin: 0; color: var(--text-dim); font-size: 0.92rem; }

  .faq-list { display: flex; flex-direction: column; gap: 0.7rem; margin-top: 1.4rem; }
  .faq-item { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 0.9rem 1.1rem; }
  .faq-item summary { font-weight: 700; cursor: pointer; font-size: 0.95rem; }
  .faq-item p { margin: 0.7rem 0 0; color: var(--text-dim); font-size: 0.92rem; }

  .cross-links { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .cross-links h3 { font-size: 1rem; margin-bottom: 0.7rem; }
  .pill-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .pill { display: inline-block; padding: 0.4rem 0.9rem; border-radius: 99px; border: 1px solid var(--border); background: var(--surface); font-size: 0.85rem; }
  .pill:hover { border-color: var(--teal); color: var(--teal); }
  .pill.teal { background: var(--teal-soft); border-color: var(--teal); color: var(--teal); font-weight: 600; }

  .cta-band { background: linear-gradient(135deg, #173247, #1f6d78); color: #f2f5f1; border-radius: 18px; padding: 2.5rem; display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .cta-band h2 { color: #fbfbf7; font-size: 1.5rem; max-width: 30ch; }
  .cta-band p { color: #cbe0dd; margin: 0.5rem 0 0; }

  @media (max-width: 700px) {
    .cross-links { grid-template-columns: 1fr; }
  }
</style>
