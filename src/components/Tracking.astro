---
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

// GTM is the single tag/pixel manager now -- GA4, Clarity, CallRail, Meta Pixel,
// etc. all get configured as Tags inside the GTM container itself, not here.
// This component's job is just: (1) load the container, (2) seed the dataLayer
// with page-level context BEFORE the container loads so pageview-triggered tags
// can read it immediately, and (3) provide the site-wide event instrumentation
// (clicks-to-call, tracked CTAs) that pushes into that same dataLayer.
interface Props {
  title: string;
  pageData?: Record<string, unknown>;
}

const { title, pageData = {} } = Astro.props;
const gtmId = import.meta.env.PUBLIC_GTM_ID;

const initialDataLayer = [
  {
    event: "page_context",
    page_path: Astro.url.pathname,
    page_title: title,
    ...pageData,
  },
];
---

{/* Vercel Web Analytics + Speed Insights -- platform-native, not routed through GTM. */}
<Analytics />
<SpeedInsights />

<script is:inline define:vars={{ initialDataLayer }}>
  window.dataLayer = window.dataLayer || [];
  initialDataLayer.forEach(function (item) {
    window.dataLayer.push(item);
  });
</script>

{/*
  Standard, direct GTM install (Google's official snippet) -- loaded on the
  main thread, not through Partytown. Partytown was tried here for the TBT/
  LCP win, but its worker sandbox never actually finished initializing in
  production (confirmed via zero googletagmanager.com/partytown.js network
  activity and window.dataLayer staying undefined indefinitely, in both a
  sandboxed test browser and a real, remotely-driven Chrome), which meant
  GTM silently never loaded at all -- no console error, no visible sign,
  just a fully dark tracking pipeline. Correctness beats the perf win here.
*/}
{gtmId && (
  <script is:inline define:vars={{ gtmId }}>
    (function (w, d, s, l, i) {
      w[l] = w[l] || [];
      w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
      var f = d.getElementsByTagName(s)[0],
        j = d.createElement(s);
      j.async = true;
      j.src = "https://www.googletagmanager.com/gtm.js?id=" + i;
      f.parentNode.insertBefore(j, f);
    })(window, document, "script", "dataLayer", gtmId);
  </script>
)}

{/*
  Site-wide event instrumentation, delegated from document so it covers every
  page without per-element listeners:
  - any tel: link click -> click_to_call
  - any element with data-gtm-event="..." [data-gtm-params='{"k":"v"}'] -> that event
  Business-specific events (form_start, generate_lead, form_error, region
  selection) are pushed directly from the components that own that logic --
  see quote.astro and index.astro.
*/}
<script is:inline>
  document.addEventListener("click", function (e) {
    window.dataLayer = window.dataLayer || [];

    var telLink = e.target.closest && e.target.closest('a[href^="tel:"]');
    if (telLink) {
      window.dataLayer.push({
        event: "click_to_call",
        phone_number: telLink.getAttribute("href").replace("tel:", ""),
        page_path: window.location.pathname,
      });
    }

    var tracked = e.target.closest && e.target.closest("[data-gtm-event]");
    if (tracked) {
      var params = {};
      try {
        params = JSON.parse(tracked.getAttribute("data-gtm-params") || "{}");
      } catch (err) {}
      window.dataLayer.push(
        Object.assign({ event: tracked.getAttribute("data-gtm-event"), page_path: window.location.pathname }, params)
      );
    }
  });
</script>
