---
import { REGIONS } from "../data/locations.js";
---

<footer class="site">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <div class="logo">
          <svg class="mark" viewBox="0 0 32 32" fill="none">
            <rect x="2" y="2" width="28" height="28" rx="7" fill="var(--teal)"></rect>
            <path d="M9 20c2-6 4-9 7-9s5 3 7 9" stroke="#fff" stroke-width="2" stroke-linecap="round" fill="none"></path>
            <circle cx="16" cy="10" r="2.4" fill="#fff"></circle>
          </svg>
          Arizona <span class="state">Pigeon Proofing</span>
        </div>
        <p class="tag">Solar panel bird proofing and cleaning, fulfilled by local Arizona crews.</p>
      </div>
      <div>
        <h2>Services</h2>
        <ul>
          <li><a href="/pigeon-proofing-solar-panels/">Pigeon Proofing</a></li>
          <li><a href="/solar-panel-cleaning/">Solar Panel Cleaning</a></li>
        </ul>
      </div>
      <div>
        <h2>Locations</h2>
        <ul>
          <li><a href={`/locations/${REGIONS.tucson.slug}/`}>{REGIONS.tucson.name}</a></li>
          <li><a href="/locations/">{REGIONS.phoenix.name} (coming soon)</a></li>
          <li><a href="/locations/">{REGIONS.rest.name} (coming soon)</a></li>
        </ul>
      </div>
      <div>
        <h2>Company</h2>
        <ul>
          <li><a href="/guides/">Resources</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 Arizona Pigeon Proofing. All rights reserved.</span>
      <span><a href="/privacy/">Privacy Policy</a> · <a href="/terms/">Terms</a></span>
    </div>
  </div>
</footer>

<style>
  footer.site { background: var(--surface-2); border-top: 1px solid var(--border); padding: 3.5rem 0 2rem; font-size: 0.9rem; }
  footer .logo { display: flex; align-items: center; gap: 0.55rem; font-family: Charter, Georgia, serif; font-weight: 700; font-size: 1.1rem; margin-bottom: 0.8rem; }
  footer .logo .mark { width: 26px; height: 26px; }
  footer .logo .state { color: var(--teal); }
  footer .tag { color: var(--text-dim); font-size: 0.85rem; max-width: 32ch; margin: 0; }
  .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 2rem; }
  .footer-grid h2 { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-dim); margin: 0 0 0.8rem; font-family: ui-monospace, monospace; font-weight: 700; }
  .footer-grid ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .footer-grid a:hover { color: var(--teal); }
  .footer-bottom { border-top: 1px solid var(--border); margin-top: 2.5rem; padding-top: 1.5rem; display: flex; justify-content: space-between; color: var(--text-dim); font-size: 0.8rem; flex-wrap: wrap; gap: 0.5rem; }
  .footer-bottom a { color: var(--text-dim); }
  .footer-bottom a:hover { color: var(--teal); }

  @media (max-width: 920px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
