---
// Slot for real job photos (SEO plan, Task 8). Nothing renders it yet: no job photos have
// been supplied, and the plan says not to add a photo section to any page without one.
// When a photo arrives, import it from src/assets and drop this in, e.g.
//   import meshPhoto from "../assets/tucson-mesh-install.jpg";
//   <JobPhoto src={meshPhoto} kind="mesh" city="Tucson" />
// Never use stock images here, and never caption a scene photo as a customer job.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  kind: "mesh" | "before" | "after" | "cleaning";
  city: string;
  caption?: string;
  eager?: boolean;
}

const { src, kind, city, caption, eager = false } = Astro.props;

// Specific, plain descriptions (not keyword-stuffed).
const ALT: Record<string, string> = {
  mesh: `Stainless bird mesh installed along the edge of a solar array on a ${city} home`,
  before: `Before: pigeon nest and droppings under solar panels in ${city}`,
  after: `After: same array sealed with bird mesh`,
  cleaning: `Solar panels in ${city} after a deionized water wash`,
};
---

<figure class="job-photo">
  <Picture
    src={src}
    formats={["avif", "webp"]}
    alt={ALT[kind]}
    widths={[480, 760, 1140]}
    sizes="(max-width: 800px) 100vw, 760px"
    loading={eager ? "eager" : "lazy"}
    decoding="async"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .job-photo { margin: 1.6rem 0; }
  .job-photo :global(img) { display: block; width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--border); }
  .job-photo figcaption { margin-top: 0.55rem; font-size: 0.82rem; color: var(--text-dim); }
</style>
