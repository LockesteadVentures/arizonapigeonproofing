---
// Real Google reviews for the fulfilling vendor, filtered to exclude any mention of the
// company name or owners by name (site plan decision -- lead-gen brand stays anonymized).
// Reused across the homepage and both service hub pages rather than duplicated per-page.
//
// No Review / AggregateRating schema on purpose (SEO plan, Task 9): Google treats reviews
// placed on the reviewed business's own site as self-serving, so the markup is not eligible
// for stars and only adds risk. The testimonials stay visible as plain content. Attribution
// ("Google review of <crew name>") is still open: it needs the crew name from the owner.
interface Props {
  heading?: string;
  eyebrow?: string;
  // Used only to label the CTA's data-gtm-params so it's distinguishable from
  // every other "Get a Free Quote" button in analytics.
  ctaLocation?: string;
}

const { heading = "What Arizona homeowners say.", eyebrow = "Local proof", ctaLocation = "testimonials" } = Astro.props;

const reviews = [
  {
    quote: "These guys did an amazing job on our solar panels! Not only did they clean the panels, install the bird proofing off the roof! When I looked at my cameras after they left, I also noticed that they also swept the rocks in my front yard because they pulled a power washer over them! They provided excellent service!! I highly recommend their services!!",
    author: "Rochelle S.",
  },
  {
    quote: "What a great job! Professional, personable, and efficient. Everything was left clean when the work was done and they made sure I had a way to contact them for issues. Thank you!",
    author: "Michelle S.",
  },
  {
    quote: "Very professional company. They did excellent work. We are so happy we found them.",
    author: "Mary S.",
  },
];
---

<div class="section-head">
  <span class="eyebrow">{eyebrow}</span>
  <h2>{heading}</h2>
</div>
<div class="trust-strip">
  {reviews.map((r) => (
    <div class="trust-card">
      <div class="stars">★★★★★</div>
      <p class="quote">"{r.quote}"</p>
      <div class="who">— {r.author}, Google review</div>
    </div>
  ))}
</div>
<div class="testimonials-cta">
  <a
    href="/quote/"
    class="btn amber"
    data-gtm-event="cta_click"
    data-gtm-params={`{"cta_location":"${ctaLocation}"}`}
  >
    Get a Free Quote
  </a>
</div>

<style>
  .trust-strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; }
  .trust-card { padding: 1.6rem; border-radius: 12px; background: var(--surface); border: 1px solid var(--border); }
  .trust-card .quote { font-size: 0.95rem; margin: 0 0 0.9rem; }
  .trust-card .who { font-size: 0.8rem; color: var(--text-dim); font-weight: 600; }
  .stars { color: var(--amber); letter-spacing: 0.1em; margin-bottom: 0.5rem; font-size: 0.85rem; }
  .testimonials-cta { text-align: center; margin-top: 2rem; }

  @media (max-width: 920px) {
    .trust-strip { grid-template-columns: 1fr; }
  }
</style>
