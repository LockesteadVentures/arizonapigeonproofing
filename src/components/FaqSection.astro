---
// Shared FAQ block: renders the visible details/summary list and emits matching
// FAQPage schema. City pages have their own inline version (with a per-city 4th
// question mixed in) and aren't migrated to this -- this is for pages that had no
// FAQ/schema at all: homepage, and both service hub pages.
interface Props {
  heading: string;
  eyebrow?: string;
  items: { q: string; a: string }[];
}

const { heading, eyebrow = "FAQ", items } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<div class="section-head">
  <span class="eyebrow">{eyebrow}</span>
  <h2>{heading}</h2>
</div>
<div class="faq-list">
  {items.map((f) => (
    <details class="faq-item">
      <summary>{f.q}</summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .faq-list { display: flex; flex-direction: column; gap: 0.7rem; margin-top: 1.4rem; }
  .faq-item { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 0.9rem 1.1rem; }
  .faq-item summary { font-weight: 700; cursor: pointer; font-size: 0.95rem; }
  .faq-item p { margin: 0.7rem 0 0; color: var(--text-dim); font-size: 0.92rem; }
</style>
