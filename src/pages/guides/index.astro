---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allGuides = await getCollection("guides", ({ data }) => !data.draft);
// Spokes live at "<hub-id>/<spoke-id>" (nested files under the hub's directory);
// group them under their hub here rather than listing all 30+ pieces flat.
const topLevel = allGuides
  .filter((g) => !g.id.includes("/"))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const spokesFor = (hubId: string) =>
  allGuides
    .filter((g) => g.id.startsWith(`${hubId}/`))
    .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title="Guides and Resources | Arizona Pigeon Proofing"
  description="Guides on solar panel bird proofing and cleaning for Arizona homeowners."
  pageData={{ content_group: "guides_index" }}
>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Resources</span>
      <h1>Guides for Arizona homeowners</h1>
      <p class="lede">Straight answers on pigeons, solar panel cleaning, HOA rules, and maintenance for Tucson-area homeowners — no sales pitch, just what to know before you call anyone.</p>
    </div>
  </section>
  <section>
    <div class="wrap narrow">
      {topLevel.length === 0 && <p class="empty-note">No guides published yet — check back soon.</p>}
      <ul class="guide-list">
        {topLevel.map((g) => {
          const spokes = spokesFor(g.id);
          return (
            <li>
              <a href={`/guides/${g.id}/`}>{g.data.title}</a>
              <p>{g.data.description}</p>
              {spokes.length > 0 && (
                <details class="spoke-toggle">
                  <summary>{spokes.length} related guides</summary>
                  <ul class="spoke-list">
                    {spokes.map((s) => (
                      <li><a href={`/guides/${s.id}/`}>{s.data.title}</a></li>
                    ))}
                  </ul>
                </details>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background: linear-gradient(160deg, #0d1620 0%, #132430 55%, #173247 100%); color: #f2f5f1; }
  .page-hero .wrap { padding: 3.5rem 1.5rem 4rem; }
  .page-hero .eyebrow { color: #7fd1d6; }
  .page-hero h1 { font-size: 2.3rem; margin: 0.6rem 0 0.9rem; color: #fbfbf7; }
  .page-hero .lede { font-size: 1.05rem; color: #c9d4d0; max-width: 52ch; margin: 0; }
  .wrap.narrow { max-width: 760px; }
  .empty-note { color: var(--text-dim); font-style: italic; margin: 2rem 0; }
  .guide-list { list-style: none; padding: 0; margin: 2rem 0; display: flex; flex-direction: column; gap: 1.4rem; }
  .guide-list a { font-weight: 700; font-size: 1.05rem; }
  .guide-list a:hover { color: var(--teal); }
  .guide-list p { margin: 0.3rem 0 0; color: var(--text-dim); font-size: 0.9rem; }
  .spoke-toggle { margin-top: 0.7rem; }
  .spoke-toggle summary {
    cursor: pointer;
    list-style: none;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--teal);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .spoke-toggle summary::-webkit-details-marker { display: none; }
  .spoke-toggle summary::before {
    content: "▸";
    font-size: 0.75rem;
    transition: transform 0.15s ease;
  }
  .spoke-toggle[open] summary::before { transform: rotate(90deg); }
  .spoke-toggle summary:hover { text-decoration: underline; }
  .spoke-list { list-style: none; padding: 0; margin: 0.7rem 0 0; padding-left: 1.1rem; border-left: 2px solid var(--border); display: flex; flex-direction: column; gap: 0.4rem; }
  .spoke-list a { font-weight: 400; font-size: 0.92rem; }
</style>
