---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, getEntry, render } from "astro:content";
import GuideCta from "../../components/GuideCta.astro";
import PriceBlock from "../../components/PriceBlock.astro";

export async function getStaticPaths() {
  const guides = await getCollection("guides", ({ data }) => !data.draft);
  return guides.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// A spoke's id is "<hub-id>/<spoke-id>" (nested file under the hub's directory
// in src/data/guides); a hub or standalone guide has no slash.
const slashIndex = entry.id.lastIndexOf("/");
const hub = slashIndex === -1 ? null : await getEntry("guides", entry.id.slice(0, slashIndex));

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishDate.toISOString(),
  // No separate last-edited tracking on these static files -- publishDate is
  // also the most recent truth we have, so it doubles as dateModified rather
  // than omitting the field Google's Article guidelines recommend.
  dateModified: entry.data.publishDate.toISOString(),
  author: { "@type": "Organization", name: "Arizona Pigeon Proofing Crew" },
  publisher: { "@type": "Organization", name: "Arizona Pigeon Proofing" },
};

// FAQPage schema is parsed straight out of the "## FAQ" markdown section
// instead of a separate frontmatter field, so it's structurally impossible
// for the schema text to drift from what's actually rendered on the page --
// Google requires the two to match, and a hand-maintained duplicate did not.
function stripInlineMarkdown(text: string) {
  return text.replace(/\[([^\]]+)\]\([^)]+\)/g, "$1").replace(/\*\*(.+?)\*\*/g, "$1");
}

function extractFaqs(markdownBody: string | undefined) {
  if (!markdownBody) return [];
  const section = markdownBody.match(/\n## FAQ\n([\s\S]*?)(?=\n## |$)/);
  if (!section) return [];
  return [...section[1].matchAll(/\*\*(.+?)\*\*\n(.+?)(?=\n\n|$)/gs)].map((m) => ({
    question: stripInlineMarkdown(m[1].trim()),
    answer: stripInlineMarkdown(m[2].trim()),
  }));
}

// Which CTA variant a guide gets. Pigeon guides point at pigeon proofing; cleaning and
// maintenance guides point at cleaning. HOA guides are left alone (not in the plan).
const ctaVariant: "pigeon" | "cleaning" | null = entry.id.startsWith("pigeons-and-solar-panels")
  ? "pigeon"
  : entry.id.startsWith("solar-panel-cleaning-arizona") || entry.id.startsWith("solar-panel-maintenance-arizona")
    ? "cleaning"
    : null;

// Cost guides also get the (gated) price block and a link to the matching Tucson page.
const COST_GUIDES: Record<string, { service: "proofing" | "cleaning"; href: string; label: string }> = {
  "pigeons-and-solar-panels/pigeon-damage-cost": { service: "proofing", href: "/pigeon-proofing-solar-panels/tucson/", label: "solar panel pigeon proofing in Tucson" },
  "pigeons-and-solar-panels/solar-panel-bird-proofing-cost-tucson": { service: "proofing", href: "/pigeon-proofing-solar-panels/tucson/", label: "solar panel pigeon proofing in Tucson" },
  "solar-panel-cleaning-arizona/solar-panel-cleaning-cost-tucson": { service: "cleaning", href: "/solar-panel-cleaning/tucson/", label: "solar panel cleaning in Tucson" },
};
const costGuide = COST_GUIDES[entry.id];

const faqs = extractFaqs(entry.body);
const faqSchema = faqs.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.question,
        acceptedAnswer: { "@type": "Answer", text: f.answer },
      })),
    }
  : null;

// Guide titles are Byword.ai-generated and vary widely in length; only append
// the brand suffix when it still fits Google's ~60-char SERP display budget,
// rather than truncating long titles mid-word.
const BRAND_SUFFIX = " | Arizona Pigeon Proofing";
const pageTitle =
  entry.data.title.length + BRAND_SUFFIX.length <= 60 ? `${entry.data.title}${BRAND_SUFFIX}` : entry.data.title;

const breadcrumbSchema = hub
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Guides", item: new URL("/guides/", Astro.site) },
        { "@type": "ListItem", position: 2, name: hub.data.title, item: new URL(`/guides/${hub.id}/`, Astro.site) },
        { "@type": "ListItem", position: 3, name: entry.data.title, item: new URL(`/guides/${entry.id}/`, Astro.site) },
      ],
    }
  : null;
---

<BaseLayout
  title={pageTitle}
  description={entry.data.description}
  pageData={{ content_group: "guide_article", guide_id: entry.id }}
>
  <section class="page-hero">
    <div class="wrap narrow">
      <span class="eyebrow">Guide</span>
      {hub && (
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/guides/">Guides</a> / <a href={`/guides/${hub.id}/`}>{hub.data.title}</a>
        </nav>
      )}
      <h1>{entry.data.title}</h1>
    </div>
  </section>
  <section>
    <div class="wrap narrow article">
      {ctaVariant && <GuideCta variant={ctaVariant} kind="inline" guideId={entry.id} />}
      <Content />
      {costGuide && (
        <>
          <PriceBlock service={costGuide.service} heading={costGuide.service === "proofing" ? "What solar panel bird proofing costs" : "What solar panel cleaning costs"} city="Tucson" />
          <p>Ready for a real number? See <a href={costGuide.href}>{costGuide.label}</a>.</p>
        </>
      )}
      {ctaVariant && <GuideCta variant={ctaVariant} kind="block" guideId={entry.id} />}
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
</BaseLayout>

<style>
  .page-hero { background: linear-gradient(160deg, #0d1620 0%, #132430 55%, #173247 100%); color: #f2f5f1; }
  .page-hero .wrap { padding: 3.5rem 1.5rem 4rem; }
  .page-hero .eyebrow { color: #7fd1d6; }
  .page-hero .breadcrumb { display: block; margin-top: 0.7rem; font-size: 0.85rem; color: #c9d4d0; }
  .page-hero .breadcrumb a { color: #c9d4d0; text-decoration: underline; }
  .page-hero .breadcrumb a:hover { color: #7fd1d6; }
  .page-hero h1 { font-size: 2rem; margin: 0.6rem 0 0; color: #fbfbf7; max-width: 30ch; }
  .wrap.narrow { max-width: 680px; }
  .article :global(h2) { font-size: 1.3rem; margin: 2rem 0 0.8rem; }
  .article :global(p) { margin: 0.9rem 0; line-height: 1.7; color: var(--text); }
  .article :global(em) { color: var(--text-dim); }
  /* Sitewide default is `a { text-decoration: none; color: inherit }` (global.css),
     which makes inline links in a wall of body text invisible as links. Article
     copy is the one place readers need to spot a link mid-sentence. */
  .article :global(a) { color: var(--teal); text-decoration: underline; text-underline-offset: 2px; }
  .article :global(a:hover) { opacity: 0.75; }
</style>
