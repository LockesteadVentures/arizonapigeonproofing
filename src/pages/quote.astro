---
import BaseLayout from "../layouts/BaseLayout.astro";
import { REGIONS } from "../data/locations.js";
---

<BaseLayout
  title="Get a Free Quote | Arizona Pigeon Proofing, Tucson AZ"
  description="Get a free quote for solar panel pigeon proofing or cleaning in Tucson, Arizona. Local crews respond within 24–48 hours."
  pageData={{ content_group: "quote" }}
>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Free Quote</span>
      <h1>Get a free quote</h1>
      <p class="lede">Tell us your city and what you're seeing — a local crew gets back to you within 24–48 hours.</p>
    </div>
  </section>
  <section>
    <div class="wrap narrow">
      <form class="quote-form" id="quote-form">
        <label>
          Name
          <input type="text" name="name" required />
        </label>
        <label>
          Phone
          <input type="tel" name="phone" required />
        </label>
        <label>
          Metro area
          <select name="metro" required>
            <option value="" disabled selected>Select your area…</option>
            <option value="tucson">{REGIONS.tucson.name}</option>
            <option value="phoenix">{REGIONS.phoenix.name} (coming soon)</option>
            <option value="rest">{REGIONS.rest.name}</option>
          </select>
        </label>
        <label>
          City / neighborhood
          <input type="text" name="city" placeholder="e.g. Oro Valley, near Tangerine Rd" required />
        </label>
        <label>
          What do you need?
          <select name="service">
            <option>Pigeon proofing</option>
            <option>Solar panel cleaning</option>
            <option>Both</option>
            <option>Not sure</option>
          </select>
        </label>
        <label class="hp" aria-hidden="true">
          Company
          <input type="text" name="company" tabindex="-1" autocomplete="off" />
        </label>
        <button type="submit" class="btn amber">Request a Quote</button>
        <p class="form-status" data-state="idle"></p>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background: linear-gradient(160deg, #0d1620 0%, #132430 55%, #173247 100%); color: #f2f5f1; }
  .page-hero .wrap { padding: 3.5rem 1.5rem 4rem; }
  .page-hero .eyebrow { color: #7fd1d6; }
  .page-hero h1 { font-size: 2.3rem; margin: 0.6rem 0 0.9rem; color: #fbfbf7; }
  .page-hero .lede { font-size: 1.05rem; color: #c9d4d0; max-width: 52ch; margin: 0; }
  .wrap.narrow { max-width: 480px; }

  .quote-form { display: flex; flex-direction: column; gap: 1.1rem; padding: 2rem 0; }
  .quote-form label { display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.88rem; font-weight: 600; }
  .quote-form input, .quote-form select {
    font: inherit; padding: 0.65rem 0.8rem; border-radius: 8px; border: 1px solid var(--border);
    background: var(--surface); color: var(--text);
  }
  .quote-form button { margin-top: 0.4rem; }
  .quote-form button[disabled] { opacity: 0.6; cursor: not-allowed; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .form-status { font-size: 0.85rem; min-height: 1.2em; }
  .form-status[data-state="success"] { color: var(--teal); font-weight: 600; }
  .form-status[data-state="error"] { color: var(--amber-dark); font-weight: 600; }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("#quote-form");
  const status = form?.querySelector<HTMLParagraphElement>(".form-status");
  const button = form?.querySelector<HTMLButtonElement>("button[type=submit]");

  // Prefill from whichever city/service page sent someone here (see
  // CityServicePage.astro's quoteUrl) -- one less thing for them to retype.
  (function prefillFromQueryParams() {
    if (!form) return;
    const params = new URLSearchParams(window.location.search);
    const metro = params.get("metro");
    const city = params.get("city");
    const service = params.get("service");

    if (metro) {
      const metroField = form.querySelector<HTMLSelectElement>('[name="metro"]');
      if (metroField && [...metroField.options].some((o) => o.value === metro)) {
        metroField.value = metro;
      }
    }
    if (city) {
      const cityField = form.querySelector<HTMLInputElement>('[name="city"]');
      if (cityField) cityField.value = city;
    }
    if (service) {
      const serviceField = form.querySelector<HTMLSelectElement>('[name="service"]');
      if (serviceField && [...serviceField.options].some((o) => o.value === service)) {
        serviceField.value = service;
      }
    }
  })();

  function pushEvent(event: string, params: Record<string, unknown> = {}) {
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event, page_path: window.location.pathname, ...params });
  }

  let startedForm = false;
  form?.addEventListener(
    "focusin",
    () => {
      if (startedForm) return;
      startedForm = true;
      pushEvent("form_start", { form_name: "quote_request" });
    },
    { once: true }
  );

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!status || !button) return;

    const formData = new FormData(form);
    const name = String(formData.get("name") ?? "");
    const phone = String(formData.get("phone") ?? "");
    const metro = String(formData.get("metro") ?? "");
    const city = String(formData.get("city") ?? "");
    const service = String(formData.get("service") ?? "");
    const payload = {
      name,
      phone,
      metro,
      city,
      service,
      company: String(formData.get("company") ?? ""),
      page: window.location.pathname,
    };

    button.disabled = true;
    status.dataset.state = "idle";
    status.textContent = "Sending…";

    try {
      const res = await fetch("/api/quote/", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const result = await res.json();

      if (res.ok && result.ok) {
        status.dataset.state = "success";
        status.textContent = "Thanks — a local crew will follow up within 24–48 hours.";
        // Raw lead info is intentional here -- GA4 is the source of truth for
        // lead data per business decision, not a default. Anyone adding a new
        // GTM tag later can now read name/phone off the dataLayer too, so
        // treat that as a live consideration when connecting new tags.
        pushEvent("generate_lead", { form_name: "quote_request", name, phone, metro, city, service });
        form.reset();
        startedForm = false;
      } else {
        status.dataset.state = "error";
        status.textContent = result.error ?? "Something went wrong. Try calling us instead.";
        pushEvent("form_error", { form_name: "quote_request", reason: result.error ?? "unknown" });
      }
    } catch {
      status.dataset.state = "error";
      status.textContent = "Something went wrong. Try calling us instead.";
      pushEvent("form_error", { form_name: "quote_request", reason: "network_error" });
    } finally {
      button.disabled = false;
    }
  });
</script>
