---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LocalStatsBlock from "../../components/LocalStatsBlock.astro";
import Testimonials from "../../components/Testimonials.astro";
import FaqSection from "../../components/FaqSection.astro";
import { liveCitiesByRegion, REGIONS } from "../../data/locations.js";
import { SERVICE_CONTENT } from "../../data/serviceContent.js";

const { signs, methodology, trustPoints } = SERVICE_CONTENT["solar-panel-cleaning"].hub;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site) },
    { "@type": "ListItem", position: 2, name: "Solar Panel Cleaning", item: new URL("/solar-panel-cleaning/", Astro.site) },
  ],
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Solar Panel Cleaning",
  serviceType: "Solar panel cleaning",
  provider: { "@type": "HomeAndConstructionBusiness", "@id": `${Astro.site}#business` },
  areaServed: { "@type": "City", name: "Tucson" },
  description: "Spot-free deionized-water solar panel cleaning, scheduled around monsoon dust and pollen.",
};

const faqs = [
  {
    q: "How much does solar panel cleaning cost?",
    a: "It depends on panel count and roof access, so we don't quote a flat number sight-unseen — every quote is based on your specific system, not a generic per-panel rate.",
  },
  {
    q: "How often should panels be cleaned in Arizona?",
    a: "Twice a year for most homes — once before monsoon season and once after — though homes near unpaved roads or agricultural land may need more.",
  },
  {
    q: "Will cleaning damage my panels?",
    a: `No — we use spot-free deionized water and soft tools only, no abrasive brushes or high-pressure spray that could risk the glass or seals. <a href="/guides/solar-panel-cleaning-arizona/deionized-water-vs-pressure-washing/">Why deionized water outperforms pressure washing on panel glass</a>.`,
  },
  {
    q: "What areas do you serve?",
    a: "Tucson Metro today — including Oro Valley, Marana, Sahuarita, and 11 more cities below. Phoenix Metro pages are built and waiting on a confirmed local crew.",
  },
  {
    q: "How much output do dirty panels actually lose?",
    a: `NREL's soiling-loss research puts a typical annual output loss around 5%, with a documented range of 2% up to 25% during long, dry, high-dust stretches between cleanings — and Arizona's monsoon-and-drought pattern pushes most local systems toward the higher end of that range, which is exactly why we recommend cleaning on both sides of monsoon season rather than once a year. <a href="/guides/solar-panel-cleaning-arizona/dust-pollen-solar-output-loss-arizona/">How that loss actually shows up over a season</a>.`,
  },
  {
    q: "Can I clean my own solar panels, or is that risky?",
    a: `Tap water leaves mineral spotting that actually reduces output, and a garden hose or pressure washer can drive water past seals or crack cold glass if it's hit with cold water on a hot panel — both common DIY mistakes. <a href="/guides/solar-panel-cleaning-arizona/diy-solar-panel-cleaning-risks/">Full breakdown of what can go wrong, and what's safe to do yourself</a>.`,
  },
  {
    q: "How do I know if my panels actually need cleaning right now?",
    a: `Dust build-up is gradual enough that most homeowners don't notice until it shows up on a utility bill — checking your monitoring app for a slow, steady output dip (not explained by shorter days or cloud cover) is the most reliable early sign. <a href="/guides/solar-panel-cleaning-arizona/signs-your-panels-need-cleaning/">How to read your monitoring app for soiling loss, and other signs to watch for</a>.`,
  },
  {
    q: "Does panel tilt angle affect how often I need to clean?",
    a: `Flatter-mounted panels hold onto dust longer than steeply tilted ones, since there's less gravity and rain assist to help clear debris between cleanings — which means two identical panels in the same neighborhood can need different schedules based on mounting angle alone. <a href="/guides/solar-panel-cleaning-arizona/does-panel-tilt-angle-affect-cleaning-frequency/">Full explanation of how tilt affects soiling rate</a>.`,
  },
  {
    q: "Does cleaning ever void my solar panel warranty?",
    a: `No, as long as it's done with non-abrasive tools and deionized water rather than a pressure washer or anything that could crack glass or force water past seals. <a href="/guides/solar-panel-cleaning-arizona/does-cleaning-void-solar-warranty/">Full warranty-language breakdown across major manufacturers</a>.`,
  },
];

const stats = [
  {
    value: "40,000",
    label: "TEP residential customers with rooftop solar as of 2022, up from ~21,000 in 2018 — about 9.8% of TEP's 400,000+ home accounts.",
    source: "Arizona Daily Star / TEP reporting",
    sourceUrl: "https://tucson.com/news/local/business/tucson-electric-solar-renewable-arizona/article_99783c90-42ee-11ee-a54c-5f3b28d08304.html",
  },
  {
    value: "Jun 15 – Sep 30",
    label: "Arizona's official monsoon season dates, fixed by the National Weather Service since 2008.",
    source: "National Weather Service",
    sourceUrl: "https://www.weather.gov/",
  },
  {
    value: "2–25%",
    label: "Documented range of annual solar output loss from soiling when panels go uncleaned — typically around 5%, per NREL research, with the higher end in long, dry, high-dust conditions like Arizona's.",
    source: "NREL",
    sourceUrl: "https://docs.nrel.gov/docs/fy22osti/83486.pdf",
  },
];
---

<BaseLayout
  title="Solar Panel Cleaning | Tucson Metro Deionized Water Wash"
  description="Dust, pollen and monsoon grime cut solar output. Spot-free deionized water cleaning by a local Tucson-area crew. Bundle with bird proofing. Free quote."
  pageData={{ content_group: "service_hub", service: "solar-panel-cleaning" }}
>
  <section class="hub-hero">
    <div class="wrap">
      <span class="eyebrow">Service</span>
      <h1>Solar Panel Cleaning</h1>
      <p class="lede">Spot-free deionized water washes, timed around Arizona's dust and monsoon season. Pick your city below for local details and a free quote.</p>
      <div class="cta-row">
        <a href="/quote/" class="btn amber" data-gtm-event="cta_click" data-gtm-params='{"cta_location":"service_hub","service":"solar-panel-cleaning"}'>Get a Free Quote</a>
      </div>
      <ul class="trust-row">
        {trustPoints.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </section>

  <section>
    <div class="wrap narrow">
      <div class="section-head">
        <span class="eyebrow">The problem</span>
        <h2>Signs your panels need cleaning</h2>
        <p>Dust and monsoon mineral spotting build up gradually, which is exactly why the output loss so often goes unnoticed until it shows up on a bill. A few signs it's time:</p>
      </div>
      <ul class="signs-list">
        {signs.map((s) => <li>{s}</li>)}
      </ul>
      <p class="guide-link-inline">
        Wondering how often is actually necessary? <a href="/guides/solar-panel-cleaning-arizona/seasonal-homeowner-cleaning-schedule/">Read the full guide →</a>
      </p>
    </div>
  </section>

  <section class="alt">
    <div class="wrap narrow">
      <div class="section-head">
        <span class="eyebrow">The process</span>
        <h2>How it's done</h2>
      </div>
      <div class="process-list">
        {methodology.map((step, i) => (
          <div class="process-step">
            <div class="n">{String(i + 1).padStart(2, "0")}</div>
            <div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap narrow">
      <LocalStatsBlock heading="Solar cleaning in Tucson, by the numbers" stats={stats} />
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <Testimonials ctaLocation="cleaning_hub_testimonials" />
    </div>
  </section>

  <section>
    <div class="wrap narrow">
      <div class="region-block">
        <h2>{REGIONS.tucson.name}</h2>
        <p class="pill-group-label">Primary service areas</p>
        <div class="city-grid">
          {liveCitiesByRegion("tucson").filter((c) => c.tier === 1).map((c) => (
            <a class="city-card primary" href={`/solar-panel-cleaning/${c.slug}/`}>{c.name}</a>
          ))}
        </div>
        <p class="pill-group-label">Also serving</p>
        <div class="city-grid">
          {liveCitiesByRegion("tucson").filter((c) => c.tier === 2).map((c) => (
            <a class="city-card" href={`/solar-panel-cleaning/${c.slug}/`}>{c.name}</a>
          ))}
        </div>
      </div>
      <div class="region-block">
        <h2>{REGIONS.phoenix.name}</h2>
        <p class="soon-note">Coming soon — pages are built, waiting on a confirmed local crew.</p>
      </div>
      <p class="guide-link">
        Curious how often panels actually need cleaning here?{" "}
        <a href="/guides/solar-panel-cleaning-arizona/seasonal-homeowner-cleaning-schedule/">Read the full guide →</a>
      </p>
    </div>
  </section>

  <section class="alt">
    <div class="wrap narrow">
      <FaqSection id="faq" heading="Frequently asked" items={faqs} />
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2>Ready to get your panels back to full output?</h2>
          <p>Tell us your city and what you're seeing — a local crew gets back to you within 24–48 hours.</p>
        </div>
        <a href="/quote/" class="btn amber" data-gtm-event="cta_click" data-gtm-params='{"cta_location":"service_hub_footer","service":"solar-panel-cleaning"}'>Get a Free Quote</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
</BaseLayout>

<style>
  .hub-hero { background: linear-gradient(160deg, #0d1620 0%, #132430 55%, #173247 100%); color: #f2f5f1; }
  .hub-hero .wrap { padding: 3.5rem 1.5rem 4rem; }
  .hub-hero .eyebrow { color: #7fd1d6; }
  .hub-hero h1 { font-size: 2.3rem; margin: 0.6rem 0 0.9rem; color: #fbfbf7; }
  .hub-hero .lede { font-size: 1.05rem; color: #c9d4d0; max-width: 52ch; margin: 0 0 1.6rem; }
  .hub-hero .cta-row { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 1.8rem; }
  .hub-hero .btn.outline { border-color: rgba(255, 255, 255, 0.28); color: #f2f5f1; }
  .hub-hero .btn.outline:hover { background: rgba(255, 255, 255, 0.08); }
  .trust-row { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.6rem 1.6rem; }
  .trust-row li { font-size: 0.85rem; color: #a8bdb9; }
  .trust-row li::before { content: "✓ "; color: #7fd1d6; }

  section.alt { background: var(--surface-2); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }

  .wrap.narrow { max-width: 760px; }

  .signs-list { list-style: none; padding: 0; margin: 1.5rem 0 0; display: flex; flex-direction: column; gap: 0.8rem; }
  .signs-list li { padding: 0.9rem 1.1rem; border-radius: 10px; background: var(--surface); border: 1px solid var(--border); font-size: 0.92rem; }
  .guide-link-inline { margin-top: 1.4rem; font-size: 0.92rem; color: var(--text-dim); }
  .guide-link-inline a { font-weight: 700; color: var(--teal); }

  .process-list { display: flex; flex-direction: column; gap: 1.4rem; margin-top: 1.5rem; }
  .process-step { display: grid; grid-template-columns: 44px 1fr; gap: 1rem; }
  .process-step .n { font-family: ui-monospace, monospace; font-weight: 700; color: var(--teal); }
  .process-step h3 { font-size: 1.05rem; margin-bottom: 0.3rem; }
  .process-step p { margin: 0; color: var(--text-dim); font-size: 0.92rem; }

  .region-block { margin-bottom: 2.5rem; }
  .region-block h2 { font-size: 1.3rem; margin-bottom: 1rem; }
  .city-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.7rem; }
  .city-card { padding: 0.8rem 1rem; border-radius: 10px; border: 1px solid var(--border); background: var(--surface); font-weight: 600; font-size: 0.92rem; }
  .city-card:hover { border-color: var(--teal); color: var(--teal); }
  .city-card.primary { border-color: var(--teal); background: var(--teal-soft); color: var(--teal); }
  .pill-group-label { font-family: ui-monospace, monospace; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-dim); margin: 0 0 0.6rem; }
  .pill-group-label:not(:first-child) { margin-top: 1.2rem; }
  .guide-link { font-size: 0.92rem; color: var(--text-dim); }
  .guide-link a { font-weight: 700; color: var(--teal); }
  .soon-note { color: var(--text-dim); font-style: italic; }

  .cta-band { background: linear-gradient(135deg, #173247, #1f6d78); color: #f2f5f1; border-radius: 18px; padding: 2.5rem; display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .cta-band h2 { color: #fbfbf7; font-size: 1.5rem; max-width: 30ch; }
  .cta-band p { color: #cbe0dd; margin: 0.5rem 0 0; }

  @media (max-width: 700px) {
    .city-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
