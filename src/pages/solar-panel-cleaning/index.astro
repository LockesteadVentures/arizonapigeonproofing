---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LocalStatsBlock from "../../components/LocalStatsBlock.astro";
import { liveCitiesByRegion, REGIONS } from "../../data/locations.js";

const stats = [
  {
    value: "40,000",
    label: "TEP residential customers with rooftop solar as of 2022, up from ~21,000 in 2018 — about 9.8% of TEP's 400,000+ home accounts.",
    source: "Arizona Daily Star / TEP reporting",
    sourceUrl: "https://tucson.com/news/local/business/tucson-electric-solar-renewable-arizona/article_99783c90-42ee-11ee-a54c-5f3b28d08304.html",
  },
  {
    value: "Jun 15 – Sep 30",
    label: "Arizona's official monsoon season dates, fixed by the National Weather Service since 2008.",
    source: "National Weather Service",
    sourceUrl: "https://www.weather.gov/",
  },
  {
    value: "4–15%",
    label: "Typical annual solar output loss from soiling when panels go uncleaned, per NREL research.",
    source: "NREL",
    sourceUrl: "https://docs.nrel.gov/docs/fy22osti/83486.pdf",
  },
];
---

<BaseLayout
  title="Solar Panel Cleaning in Tucson, AZ | Arizona Pigeon Proofing"
  description="Deionized-water solar panel cleaning across Tucson, Arizona — scheduled around monsoon season and pollen."
  pageData={{ content_group: "service_hub", service: "solar-panel-cleaning" }}
>
  <section class="hub-hero">
    <div class="wrap">
      <span class="eyebrow">Service</span>
      <h1>Solar Panel Cleaning</h1>
      <p class="lede">Spot-free deionized water washes, timed around Arizona's dust and monsoon season. Pick your city below for local details and a free quote.</p>
      <a href="/quote/" class="btn amber" data-gtm-event="cta_click" data-gtm-params='{"cta_location":"service_hub","service":"solar-panel-cleaning"}'>Get a Free Quote</a>
    </div>
  </section>

  <section class="alt">
    <div class="wrap narrow">
      <LocalStatsBlock heading="Solar cleaning in Tucson, by the numbers" stats={stats} />
    </div>
  </section>

  <section>
    <div class="wrap narrow">
      <div class="region-block">
        <h2>{REGIONS.tucson.name}</h2>
        <div class="city-grid">
          {liveCitiesByRegion("tucson").map((c) => (
            <a class="city-card" href={`/solar-panel-cleaning/${c.slug}/`}>{c.name}</a>
          ))}
        </div>
      </div>
      <div class="region-block">
        <h2>{REGIONS.phoenix.name}</h2>
        <p class="soon-note">Coming soon — pages are built, waiting on a confirmed local crew.</p>
      </div>
      <p class="guide-link">
        Curious how often panels actually need cleaning here?
        <a href="/guides/solar-panel-cleaning-frequency-arizona/">Read the full guide →</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hub-hero { background: linear-gradient(160deg, #0d1620 0%, #132430 55%, #173247 100%); color: #f2f5f1; }
  .hub-hero .wrap { padding: 3.5rem 1.5rem 4rem; }
  .hub-hero .eyebrow { color: #7fd1d6; }
  .hub-hero h1 { font-size: 2.3rem; margin: 0.6rem 0 0.9rem; color: #fbfbf7; }
  .hub-hero .lede { font-size: 1.05rem; color: #c9d4d0; max-width: 52ch; margin: 0 0 1.6rem; }

  section.alt { background: var(--surface-2); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }

  .wrap.narrow { max-width: 760px; }
  .region-block { margin-bottom: 2.5rem; }
  .region-block h2 { font-size: 1.3rem; margin-bottom: 1rem; }
  .city-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.7rem; }
  .city-card { padding: 0.8rem 1rem; border-radius: 10px; border: 1px solid var(--border); background: var(--surface); font-weight: 600; font-size: 0.92rem; }
  .city-card:hover { border-color: var(--teal); color: var(--teal); }
  .guide-link { font-size: 0.92rem; color: var(--text-dim); }
  .guide-link a { font-weight: 700; color: var(--teal); }
  .soon-note { color: var(--text-dim); font-style: italic; }

  @media (max-width: 700px) {
    .city-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
