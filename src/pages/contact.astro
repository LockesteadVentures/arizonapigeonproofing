---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact | Arizona Pigeon Proofing"
  description="Get in touch with Arizona Pigeon Proofing for a free quote on solar panel bird proofing or cleaning."
  pageData={{ content_group: "contact" }}
>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Contact</span>
      <h1>Talk to us</h1>
      <p class="lede">Call, or use the quote form — a local crew will follow up within 24–48 hours.</p>
      <a href="tel:+15205550148" class="btn amber">Call (520) 555-0148</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background: linear-gradient(160deg, #0d1620 0%, #132430 55%, #173247 100%); color: #f2f5f1; }
  .page-hero .wrap { padding: 3.5rem 1.5rem 4rem; }
  .page-hero .eyebrow { color: #7fd1d6; }
  .page-hero h1 { font-size: 2.3rem; margin: 0.6rem 0 0.9rem; color: #fbfbf7; }
  .page-hero .lede { font-size: 1.05rem; color: #c9d4d0; max-width: 52ch; margin: 0 0 1.6rem; }
</style>
