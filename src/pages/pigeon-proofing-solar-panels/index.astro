---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LocalStatsBlock from "../../components/LocalStatsBlock.astro";
import Testimonials from "../../components/Testimonials.astro";
import FaqSection from "../../components/FaqSection.astro";
import PigeonPhoto from "../../components/PigeonPhoto.astro";
import { liveCitiesByRegion, REGIONS } from "../../data/locations.js";
import { SERVICE_CONTENT } from "../../data/serviceContent.js";

const { signs, methodology, trustPoints } = SERVICE_CONTENT["pigeon-proofing-solar-panels"].hub;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site) },
    { "@type": "ListItem", position: 2, name: "Pigeon Proofing for Solar Panels", item: new URL("/pigeon-proofing-solar-panels/", Astro.site) },
  ],
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Pigeon Proofing for Solar Panels",
  serviceType: "Bird mesh installation",
  provider: { "@type": "HomeAndConstructionBusiness", "@id": `${Astro.site}#business` },
  areaServed: { "@type": "City", name: "Tucson" },
  description: "Stainless mesh installed around solar arrays to stop pigeons from nesting underneath.",
};

const faqs = [
  {
    q: "How much does solar panel bird mesh cost?",
    a: "It depends on your array size and roof access, so we don't quote a flat number sight-unseen — every quote is based on your specific panels, not a generic per-panel rate.",
  },
  {
    q: "How long does pigeon proofing take?",
    a: "Most jobs, including removing any existing nest, finish in a single visit — same day in most cases.",
  },
  {
    q: "Does bird mesh void my solar panel warranty?",
    a: `No — mesh mounts to the panel's rails, not the roof or the panels themselves, so it doesn't affect your manufacturer or installer warranty. <a href="/guides/pigeons-and-solar-panels/does-bird-mesh-void-solar-warranty/">See how this holds up across major panel manufacturers' warranty language</a>.`,
  },
  {
    q: "What areas do you serve?",
    a: "Tucson Metro today — including Oro Valley, Marana, Sahuarita, and 11 more cities below. Phoenix Metro pages are built and waiting on a confirmed local crew.",
  },
  {
    q: "Bird mesh, spikes, sonic deterrents, or decoys — which actually works for solar panels?",
    a: `Mesh is the only method that physically blocks the space under the array rather than just discouraging birds from using it — spikes and sonic deterrents can push pigeons to a neighboring roof instead of solving the problem, and decoys tend to stop working once pigeons get used to them. <a href="/guides/pigeons-and-solar-panels/bird-mesh-vs-spikes-vs-sonic-vs-decoys/">Full comparison of all four methods</a>.`,
  },
  {
    q: "How much damage can pigeons actually do to a solar array?",
    a: `Beyond the mess, droppings are acidic enough to degrade panel coatings and roofing material over time, and accumulated nesting debris can block airflow that panels need to run efficiently — costs that tend to compound the longer nesting goes unaddressed. <a href="/guides/pigeons-and-solar-panels/pigeon-damage-cost/">What that typically costs to repair, and how it compares to prevention</a>.`,
  },
  {
    q: "Are pigeon droppings under solar panels a health risk?",
    a: `Dried pigeon droppings can carry histoplasmosis and other fungal spores that become airborne when disturbed, which is why we wear PPE and sanitize the area during nest removal rather than just sweeping it out. <a href="/guides/pigeons-and-solar-panels/pigeon-dropping-health-risks/">Full health-risk breakdown and safe-handling guidance</a>.`,
  },
  {
    q: "Do I need HOA approval to install bird mesh in Arizona?",
    a: `Arizona law (A.R.S. § 33-1816) prevents an HOA from banning solar panels outright, but that protection covers the solar system itself — bird mesh, as an added accessory, typically still goes through your community's standard architectural review. Most HOAs approve it quickly since it's barely visible from the street. <a href="/guides/hoa-solar-panel-rules-arizona/bird-mesh-architectural-review/">What that review actually asks for, and what to submit</a>.`,
  },
  {
    q: "Can I install bird mesh myself, or should I hire a professional?",
    a: `DIY mesh kits exist, but a loose or gapped install often just relocates the problem to the next unsealed edge, and re-doing it professionally after a failed DIY attempt usually costs more than starting with a pro. <a href="/guides/pigeons-and-solar-panels/diy-vs-professional-pigeon-proofing/">Full DIY-vs-professional breakdown, including where DIY can work fine</a>.`,
  },
];

const stats = [
  {
    value: "40,000",
    label: "TEP residential customers with rooftop solar as of 2022, up from ~21,000 in 2018 — about 9.8% of TEP's 400,000+ home accounts.",
    source: "Arizona Daily Star / TEP reporting",
    sourceUrl: "https://tucson.com/news/local/business/tucson-electric-solar-renewable-arizona/article_99783c90-42ee-11ee-a54c-5f3b28d08304.html",
  },
  {
    value: "Jun 15 – Sep 30",
    label: "Arizona's official monsoon season, fixed by the National Weather Service — worth clearing nests before it starts, not after.",
    source: "National Weather Service",
    sourceUrl: "https://www.weather.gov/",
  },
];
---

<BaseLayout
  title="Solar Panel Pigeon Proofing | Tucson Metro Bird Mesh"
  description="Pigeons nesting under your solar panels? Stainless bird mesh, nest removal and sanitizing by a local Tucson-area crew. Free quote in 24-48 hours."
  pageData={{ content_group: "service_hub", service: "pigeon-proofing-solar-panels" }}
>
  <section class="hub-hero">
    <div class="wrap">
      <span class="eyebrow">Service</span>
      <h1>Pigeon Proofing for Solar Panels</h1>
      <p class="lede">Stainless mesh, fitted to your array, installed by a local Tucson crew. Pick your city below for local details and a free quote.</p>
      <div class="cta-row">
        <a href="/quote/" class="btn amber" data-gtm-event="cta_click" data-gtm-params='{"cta_location":"service_hub","service":"pigeon-proofing-solar-panels"}'>Get a Free Quote</a>
      </div>
      <ul class="trust-row">
        {trustPoints.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </section>

  <section>
    <div class="wrap narrow">
      <div class="section-head">
        <span class="eyebrow">The problem</span>
        <h2>Signs you have pigeons nesting under your panels</h2>
        <p>The gap between a raised solar array and the roof is exactly the sheltered, warm spot pigeons look for in Arizona's heat. A few signs it's already happened:</p>
      </div>
      <PigeonPhoto />
      <ul class="signs-list">
        {signs.map((s) => <li>{s}</li>)}
      </ul>
      <p class="guide-link-inline">
        Curious how much actual damage this causes? <a href="/guides/pigeons-and-solar-panels/pigeon-damage-cost/">Read the full guide →</a>
      </p>
    </div>
  </section>

  <section class="alt">
    <div class="wrap narrow">
      <div class="section-head">
        <span class="eyebrow">The process</span>
        <h2>How it's done</h2>
      </div>
      <div class="process-list">
        {methodology.map((step, i) => (
          <div class="process-step">
            <div class="n">{String(i + 1).padStart(2, "0")}</div>
            <div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap narrow">
      <LocalStatsBlock heading="Solar in Tucson, by the numbers" stats={stats} />
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <Testimonials ctaLocation="pigeon_hub_testimonials" />
    </div>
  </section>

  <section>
    <div class="wrap narrow">
      <div class="region-block">
        <h2>{REGIONS.tucson.name}</h2>
        <p class="pill-group-label">Primary service areas</p>
        <div class="city-grid">
          {liveCitiesByRegion("tucson").filter((c) => c.tier === 1).map((c) => (
            <a class="city-card primary" href={`/pigeon-proofing-solar-panels/${c.slug}/`}>{c.name}</a>
          ))}
        </div>
        <p class="pill-group-label">Also serving</p>
        <div class="city-grid">
          {liveCitiesByRegion("tucson").filter((c) => c.tier === 2).map((c) => (
            <a class="city-card" href={`/pigeon-proofing-solar-panels/${c.slug}/`}>{c.name}</a>
          ))}
        </div>
      </div>
      <div class="region-block">
        <h2>{REGIONS.phoenix.name}</h2>
        <p class="soon-note">Coming soon — pages are built, waiting on a confirmed local crew.</p>
      </div>
      <p class="guide-link">
        Wondering whether your HOA needs to sign off first?
        <a href="/guides/hoa-solar-panel-rules-arizona/bird-mesh-architectural-review/">Read the full guide →</a>
      </p>
    </div>
  </section>

  <section class="alt">
    <div class="wrap narrow">
      <FaqSection id="faq" heading="Frequently asked" items={faqs} />
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2>Ready to stop losing output to pigeons?</h2>
          <p>Tell us your city and what you're seeing — a local crew gets back to you within 24–48 hours.</p>
        </div>
        <a href="/quote/" class="btn amber" data-gtm-event="cta_click" data-gtm-params='{"cta_location":"service_hub_footer","service":"pigeon-proofing-solar-panels"}'>Get a Free Quote</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
</BaseLayout>

<style>
  .hub-hero { background: linear-gradient(160deg, #0d1620 0%, #132430 55%, #173247 100%); color: #f2f5f1; }
  .hub-hero .wrap { padding: 3.5rem 1.5rem 4rem; }
  .hub-hero .eyebrow { color: #7fd1d6; }
  .hub-hero h1 { font-size: 2.3rem; margin: 0.6rem 0 0.9rem; color: #fbfbf7; }
  .hub-hero .lede { font-size: 1.05rem; color: #c9d4d0; max-width: 52ch; margin: 0 0 1.6rem; }
  .hub-hero .cta-row { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 1.8rem; }
  .hub-hero .btn.outline { border-color: rgba(255, 255, 255, 0.28); color: #f2f5f1; }
  .hub-hero .btn.outline:hover { background: rgba(255, 255, 255, 0.08); }
  .trust-row { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.6rem 1.6rem; }
  .trust-row li { font-size: 0.85rem; color: #a8bdb9; }
  .trust-row li::before { content: "✓ "; color: #7fd1d6; }

  section.alt { background: var(--surface-2); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }

  .wrap.narrow { max-width: 760px; }

  .signs-list { list-style: none; padding: 0; margin: 1.5rem 0 0; display: flex; flex-direction: column; gap: 0.8rem; }
  .signs-list li { padding: 0.9rem 1.1rem; border-radius: 10px; background: var(--surface); border: 1px solid var(--border); font-size: 0.92rem; }
  .guide-link-inline { margin-top: 1.4rem; font-size: 0.92rem; color: var(--text-dim); }
  .guide-link-inline a { font-weight: 700; color: var(--teal); }

  .process-list { display: flex; flex-direction: column; gap: 1.4rem; margin-top: 1.5rem; }
  .process-step { display: grid; grid-template-columns: 44px 1fr; gap: 1rem; }
  .process-step .n { font-family: ui-monospace, monospace; font-weight: 700; color: var(--teal); }
  .process-step h3 { font-size: 1.05rem; margin-bottom: 0.3rem; }
  .process-step p { margin: 0; color: var(--text-dim); font-size: 0.92rem; }

  .region-block { margin-bottom: 2.5rem; }
  .region-block h2 { font-size: 1.3rem; margin-bottom: 1rem; }
  .city-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.7rem; }
  .city-card { padding: 0.8rem 1rem; border-radius: 10px; border: 1px solid var(--border); background: var(--surface); font-weight: 600; font-size: 0.92rem; }
  .city-card:hover { border-color: var(--teal); color: var(--teal); }
  .city-card.primary { border-color: var(--teal); background: var(--teal-soft); color: var(--teal); }
  .soon-note { color: var(--text-dim); font-style: italic; }
  .pill-group-label { font-family: ui-monospace, monospace; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-dim); margin: 0 0 0.6rem; }
  .pill-group-label:not(:first-child) { margin-top: 1.2rem; }
  .guide-link { font-size: 0.92rem; color: var(--text-dim); }
  .guide-link a { font-weight: 700; color: var(--teal); }

  .cta-band { background: linear-gradient(135deg, #173247, #1f6d78); color: #f2f5f1; border-radius: 18px; padding: 2.5rem; display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .cta-band h2 { color: #fbfbf7; font-size: 1.5rem; max-width: 30ch; }
  .cta-band p { color: #cbe0dd; margin: 0.5rem 0 0; }

  @media (max-width: 700px) {
    .city-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
