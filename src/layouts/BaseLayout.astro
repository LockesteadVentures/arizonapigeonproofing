---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Tracking from "../components/Tracking.astro";
import GtmNoscript from "../components/GtmNoscript.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  // Page-level context seeded into the dataLayer before GTM loads -- e.g.
  // { content_group: "city_service_page", metro: "tucson", service: "...", city: "..." }
  pageData?: Record<string, unknown>;
}

const { title, description, pageData = {} } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Arizona Pigeon Proofing",
  url: Astro.site?.toString(),
  telephone: "+1-520-555-0148",
  areaServed: {
    "@type": "City",
    name: "Tucson",
    containedInPlace: { "@type": "AdministrativeArea", name: "Arizona" },
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Arizona Pigeon Proofing" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <Tracking title={title} pageData={pageData} />
  </head>
  <body>
    <GtmNoscript />
    {import.meta.env.DEV && (
      <div class="mockup-badge">DEV BUILD — placeholder copy, pending Byword.ai content pass</div>
    )}
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .mockup-badge {
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
    text-align: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--text-dim);
    padding: 0.45rem 1rem;
  }
</style>
