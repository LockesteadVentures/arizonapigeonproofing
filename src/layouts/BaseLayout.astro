---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Tracking from "../components/Tracking.astro";
import GtmNoscript from "../components/GtmNoscript.astro";
import { liveCitiesByRegion } from "../data/locations.js";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  // Page-level context seeded into the dataLayer before GTM loads -- e.g.
  // { content_group: "city_service_page", metro: "tucson", service: "...", city: "..." }
  pageData?: Record<string, unknown>;
  // Schema.org areaServed for THIS page specifically -- a single {name} for a city
  // page, or an array for a page that covers multiple cities. Defaults to every
  // live Tucson-area city, which is accurate for the homepage/hub pages but was
  // previously hardcoded to "Tucson" even on Oro Valley/Vail/etc pages, wasting
  // the local-relevance signal those pages should carry.
  areaServed?: { name: string } | { name: string }[];
}

const { title, description, pageData = {}, areaServed } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const defaultAreaServed = liveCitiesByRegion("tucson").map((c) => ({
  "@type": "City",
  name: c.name,
  containedInPlace: { "@type": "AdministrativeArea", name: "Arizona" },
}));

const resolvedAreaServed = areaServed
  ? Array.isArray(areaServed)
    ? areaServed.map((a) => ({
        "@type": "City",
        name: a.name,
        containedInPlace: { "@type": "AdministrativeArea", name: "Arizona" },
      }))
    : { "@type": "City", name: areaServed.name, containedInPlace: { "@type": "AdministrativeArea", name: "Arizona" } }
  : defaultAreaServed;

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  // Fixed @id (not per-page) so the Review/AggregateRating block emitted separately
  // by Testimonials.astro merges into this same entity instead of reading as a
  // second, distinct business with the same name.
  "@id": `${Astro.site}#business`,
  name: "Arizona Pigeon Proofing",
  url: Astro.site?.toString(),
  areaServed: resolvedAreaServed,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Arizona Pigeon Proofing" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

    <Tracking title={title} pageData={pageData} />
  </head>
  <body>
    <GtmNoscript />
    {import.meta.env.DEV && (
      <div class="mockup-badge">DEV BUILD — placeholder copy, pending Byword.ai content pass</div>
    )}
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .mockup-badge {
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
    text-align: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--text-dim);
    padding: 0.45rem 1rem;
  }
</style>
