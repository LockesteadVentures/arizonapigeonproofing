# Copy to .env for local dev, and set these as Environment Variables in the
# Vercel project settings for production. Never commit the real .env file.

# --- Quote pipeline (src/pages/api/quote.ts) ---
# Resend: https://resend.com — free tier is enough to start. Requires a
# verified sending domain for production (their onboarding@resend.dev sender
# works for testing without one).
RESEND_API_KEY=
RESEND_FROM_EMAIL=quotes@arizonapigeonproofing.com
# Recipient for Tucson leads (the confirmed vendor) — see locations.js VENDOR_BY_REGION
LEAD_EMAIL_TUCSON=
# Recipient for anything outside a fulfilled region (Phoenix, unrecognized cities) —
# should be you, for manual triage, until those regions have a confirmed vendor.
LEAD_EMAIL_FALLBACK=

# --- Byword.ai pipeline (src/pages/api/webhook/byword.ts) ---
# Fine-grained GitHub PAT scoped to LockesteadVentures/arizonapigeonproofing only,
# with Contents: Read & write and Pull requests: Read & write.
GITHUB_TOKEN=
# Shared secret — set this same value in Byword's/Zapier's webhook header
# (x-webhook-secret) so randos on the internet can't open PRs against the repo.
BYWORD_WEBHOOK_SECRET=

# --- Tracking pipeline (src/components/Tracking.astro) ---
# All three are optional — each block no-ops until its var is set.
# Vercel Web Analytics/Speed Insights need no env vars at all; they work
# automatically once deployed on Vercel.
PUBLIC_GA4_ID=
PUBLIC_CLARITY_ID=
PUBLIC_CALLRAIL_COMPANY_ID=
